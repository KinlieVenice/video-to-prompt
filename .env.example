# Copy to .env.local in the project root, then restart the Next.js server.
# Keep your existing .env.local if you have already configured this machine.
# .env.local, .venv and .tmp are ignored by Git.

# 9router connection. Paste your router API key after the equals sign.
# Non-empty values here override the corresponding browser settings.
# The key is used on the server and is never returned to the browser.
NINE_ROUTER_BASE_URL=http://127.0.0.1:20128/v1
NINE_ROUTER_API_KEY=
# Optional: full ID of your tested OpenAI vision model, including its prefix.
# Leave blank to select the model in the app's Settings.
NINE_ROUTER_MODEL=

# Experimental Flow bridge: dedicated signed-in Chrome on this loopback CDP port.
# Start it with scripts/flow/start-inspection-browser.ps1 -Visible.
# Google credentials remain in that separate Chrome profile, never in this file.
FLOW_CDP_ENDPOINT=http://127.0.0.1:9223

# Guided workflow defaults. Restart Next.js after editing; new projects only.
# Flow model IDs: OMNI_FLASH (Omni 1.1 Flash), VEO_LITE (requires 720p / 8s).
STUDIO_DEFAULT_FLOW_MODEL=OMNI_FLASH
STUDIO_DEFAULT_FLOW_RESOLUTION=360p
STUDIO_DEFAULT_MAX_DURATION=8
STUDIO_DEFAULT_STRATEGY=FIRST_LAST
STUDIO_DEFAULT_OVERLAP=0
STUDIO_DEFAULT_ASPECT=9:16
STUDIO_DEFAULT_EXPRESSION=EXPRESSIVE
STUDIO_DEFAULT_BACKGROUND_MODE=SOURCE
STUDIO_DEFAULT_BACKGROUND_PROMPT=
STUDIO_DEFAULT_COMPLETE_SCENE=true
STUDIO_DEFAULT_IMAGE_MODEL=cx/gpt-image-2.5-sunburst
STUDIO_DEFAULT_AUDIO_MODE=ORIGINAL
# Blank uses the planner's official baseline; override is credits per clip.
STUDIO_DEFAULT_CREDIT_OVERRIDE=

# Local Whisper: create the venv and install its dependencies first:
# python -m venv .venv
# .venv/Scripts/python.exe -m pip install -r scripts/requirements-whisper.txt

# Windows interpreter. An absolute path with forward slashes also works.
STUDIO_PYTHON=.venv/Scripts/python.exe
# macOS/Linux alternative:
# STUDIO_PYTHON=.venv/bin/python

# Lightweight multilingual model for Filipino, English and Taglish.
# First use downloads weights; use a multilingual model, without an .en suffix.
STUDIO_WHISPER_MODEL=base
STUDIO_WHISPER_DEVICE=cpu
STUDIO_WHISPER_COMPUTE_TYPE=int8

# Keep downloaded model weights in this project's ignored cache directory.
HF_HOME=.tmp/huggingface
# Optional: enable only AFTER downloading the selected model successfully.
# HF_HUB_OFFLINE=1

# Optional storage override; default is .studio in the project root.
# STUDIO_DATA_DIR=.studio

# Optional overrides for the FFmpeg binaries installed by npm.
# Use absolute executable paths when overriding; forward slashes work on Windows.
# FFMPEG_PATH=C:/tools/ffmpeg/bin/ffmpeg.exe
# FFPROBE_PATH=C:/tools/ffmpeg/bin/ffprobe.exe
